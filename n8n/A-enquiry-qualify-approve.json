    {
      "parameters": {
        "jsCode": "// Builds the OpenRouter request. EDIT THE CRITERIA BELOW to change what \"good fit\" means.\nconst s = $input.first().json;            // Settings + the Agency OS event\nconst e = (s.event && s.event.payload) || {};\n\nconst system = `You triage new enquiries for Marmoset Digital Media, a digital marketing agency in Melbourne, Australia.\nMarmoset's main offer is a $800 + GST \"Paid Discovery\": a 3-hour strategy session plus a written monthly marketing plan. It usually leads to a $3,000/month done-for-you marketing program.\n\nGOOD FIT: an established Australian business (or one clearly ready to invest) wanting ongoing help with digital marketing, websites, SEO, social media or online strategy.\nPOOR FIT: tiny one-off jobs, no budget, students, job or internship seekers, requests outside marketing, businesses well outside Australia.\nSPAM: sales pitches TO Marmoset (SEO, link building, web design, offshore development, lead lists), automated or nonsense messages, crypto, anything that is not a real enquiry.\n\nReply with JSON only, no other text:\n{\"verdict\":\"good_fit\"|\"poor_fit\"|\"spam\",\"summary\":\"two short sentences for the agency owner\",\"reason\":\"one short phrase\"}`;\n\nconst user = [\n  `Name: ${[e.first_name, e.last_name].filter(Boolean).join(' ') || '(not given)'}`,\n  `Email: ${e.email || '(not given)'}`,\n  `Phone: ${e.phone || '(not given)'}`,\n  `Business: ${e.company_name || '(not given)'}`,\n  `Website: ${e.website || '(not given)'}`,\n  `Interested in: ${e.service_interest || '(not given)'}`,\n  `Existing client: ${e.company_id ? 'yes' : 'no'}`,\n  '',\n  'Message:',\n  e.message || '(empty)',\n].join('\\n');\n\nreturn [{ json: { ...s, request: {\n  model: s.MODEL,\n  temperature: 0,\n  max_tokens: 300,\n  response_format: { type: 'json_object' },\n  messages: [{ role: 'system', content: system }, { role: 'user', content: user }],\n} } }];"
      },
      "id": "fae3b1d8-a9eb-48f0-a91a-30a064af2e3b",
      "name": "Build prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.request) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "87138fe4-3d05-4c54-a51a-d3c9fe77f6f9",
      "name": "AI triage (OpenRouter)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Turns the AI reply into a verdict plus the approval email. Never fails: if the AI reply\n// cannot be read, the enquiry still goes to admin@ marked \"Not triaged\".\nconst s = $('Build prompt').first().json;\nconst e = (s.event && s.event.payload) || {};\n\nlet v = { verdict: 'unknown', summary: '', reason: '' };\ntry {\n  const txt = $input.first().json.choices[0].message.content;\n  const m = String(txt).match(/\\{[\\s\\S]*\\}/);\n  v = { ...v, ...JSON.parse(m ? m[0] : txt) };\n} catch (err) {\n  v.summary = 'AI triage failed. Please read the enquiry yourself.';\n}\nif (!['good_fit', 'poor_fit', 'spam'].includes(v.verdict)) v.verdict = 'unknown';\n\nconst esc = (x) => String(x ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst name = [e.first_name, e.last_name].filter(Boolean).join(' ') || e.email;\nconst label = { good_fit: 'Good fit', poor_fit: 'Poor fit', spam: 'Spam', unknown: 'Not triaged' }[v.verdict];\nconst who = e.company_name ? `${e.company_name} (${name})` : name;\nconst subject = (v.verdict === 'good_fit' ? 'New enquiry: ' : `New enquiry [${label}]: `) + who;\n\nconst row = (k, val) => val ? `<tr><td style=\"padding:2px 12px 2px 0;color:#666\">${k}</td><td>${esc(val)}</td></tr>` : '';\nconst html =\n  `<p><strong>AI verdict: ${label}</strong>${v.reason ? ` (${esc(v.reason)})` : ''}<br>${esc(v.summary)}</p>` +\n  (e.company_id ? `<p><em>This email matches an existing client in Agency OS.</em></p>` : '') +\n  `<table style=\"border-collapse:collapse\">` +\n  row('Name', name) + row('Email', e.email) + row('Phone', e.phone) + row('Business', e.company_name) +\n  row('Website', e.website) + row('Interested in', e.service_interest) +\n  `</table>` +\n  `<p style=\"white-space:pre-wrap;border-left:3px solid #ddd;padding-left:10px\">${esc(e.message || '(no message)')}</p>` +\n  `<p><strong>Approve</strong> creates the client in Agency OS and emails ${esc(e.email)} the ` +\n  `$800 Paid Discovery proposal. <strong>Decline</strong> sends nothing.</p>`;\n\nreturn [{ json: {\n  enquiry_id: e.enquiry_id || (s.event && s.event.entityId),\n  verdict: v.verdict, summary: v.summary, reason: v.reason, model: s.MODEL,\n  subject, html, name, email: e.email, company: e.company_name || null,\n  AGENCY_OS: s.AGENCY_OS, APPROVER: s.APPROVER, FROM: s.FROM, TEMPLATE: s.TEMPLATE,\n} }];"
      },
